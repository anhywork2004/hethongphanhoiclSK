// Prisma schema cho hệ thống Quản trị Máy móc & Bảo trì + Sự cố Chất lượng (QA / 5M+1E) — Hợp nhất TBS Máy Móc & TBS HTPH-CLSK

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Client riêng cho Cloudflare Workers: dùng wasm-compiler-edge (import file .wasm thật)
// thay vì decode base64 + WebAssembly.Module() lúc runtime — cách này bị workerd chặn
// (CompileError: Wasm code generation disallowed by embedder).
generator clientWorkerd {
  provider = "prisma-client"
  output   = "../src/generated/prisma-workerd"
  runtime  = "workerd"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN // Chỉ dùng web-admin
  OPERATOR // NV vận hành — báo cáo sự cố máy & CLSK
  QA // QA — điều tra 5M+1E
  LINE_LEADER // Trưởng line — điều tra 5M+1E, chốt nguyên nhân gốc, xác nhận hoàn thành 3h-48h
  TECHNOLOGY // Công nghệ — điều tra 5M+1E
  DEPARTMENT_HEAD // Trưởng phòng ban — phân việc cho bảo trì cùng khu vực
  MAINTENANCE // Bảo trì — nhận việc, sửa chữa, nhóm chat
}

enum CategoryType {
  AREA // Khu vực / Xưởng
  PRODUCTION_LINE // Chuyền
  TEAM // Tổ
  MAINTENANCE_PERIOD // Bảo trì định kỳ (Máy Móc)
  MACHINE_STATUS // Trạng thái máy (Máy Móc)
  MACHINE_TYPE // Phân loại máy (Máy Móc)
}

enum StatusKind {
  ACTIVE
  STOPPED
  MAINTENANCE
}

model Category {
  id         String       @id @default(cuid())
  type       CategoryType
  name       String
  days       Int?
  statusKind StatusKind?
  isDefault  Boolean      @default(false)
  colorHex   String?
  order      Int          @default(0)
  createdAt  DateTime     @default(now())

  machinesByArea              Machine[]      @relation("MachineArea")
  machinesByTeam              Machine[]      @relation("MachineTeam")
  machinesByProductionLine    Machine[]      @relation("MachineProductionLine")
  machinesByStatus            Machine[]      @relation("MachineStatus")
  machinesByMaintenancePeriod Machine[]      @relation("MachineMaintenancePeriod")
  machinesByType              Machine[]      @relation("MachineType")
  usersByArea                 User[]         @relation("UserArea")
  issuesByArea                QualityIssue[] @relation("IssueArea")
  issuesByTeam                QualityIssue[] @relation("IssueTeam")
  issuesByProductionLine      QualityIssue[] @relation("IssueProductionLine")

  @@unique([type, name])
  @@map("categories")
}

model IssueFailureCategory {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  issues QualityIssue[]

  @@map("issue_failure_categories")
}

model PartCategory {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("part_categories")
}

enum IncidentStatus {
  PENDING
  ACCEPTED
  DONE
}

enum ChatMessageType {
  TEXT
  INCIDENT_ALERT
  SYSTEM
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum RatingStatus {
  PENDING
  SUBMITTED
}

model User {
  id           String   @id @default(cuid())
  employeeCode String   @unique
  name         String
  phone        String?
  passwordHash String
  avatarUrl    String?
  pushToken    String?
  role         Role     @default(OPERATOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  areaId String?
  area   Category? @relation("UserArea", fields: [areaId], references: [id])

  reportedIncidents   Incident[]        @relation("Reporter")
  assignedIncidents   Incident[]        @relation("AssignedTo")
  maintenanceLogs     MaintenanceLog[]
  chatMemberships     ChatGroupMember[]
  chatMessages        ChatMessage[]
  receivedInvitations GroupInvitation[] @relation("InvitedUser")
  sentInvitations     GroupInvitation[] @relation("InvitedBy")
  announcements       Announcement[]
  ratingRequests      RatingRequest[]

  // HTPH-CLSK Relations
  reportedIssues       QualityIssue[]        @relation("Reporter")
  rootCauseDecisions   QualityIssue[]        @relation("RootCauseDecidedBy")
  fiveMOneESubmissions FiveMOneESubmission[]
  assignedTasks        MaintenanceTask[]     @relation("TaskAssignedBy")
  assigneeTasks        MaintenanceTask[]     @relation("TaskAssignee")
  verifiedTasks        MaintenanceTask[]     @relation("TaskVerifiedBy")

  @@map("users")
}

model Machine {
  id              String  @id @default(cuid())
  code            String  @unique
  serialNumber    String?
  name            String
  location        String
  latitude        Float?
  longitude       Float?
  model           String?
  manufacturer    String?
  origin          String?
  manufactureYear Int?
  yearInUse       Int?
  specs           String?

  areaId String?
  area   Category? @relation("MachineArea", fields: [areaId], references: [id])

  teamId String?
  team   Category? @relation("MachineTeam", fields: [teamId], references: [id])

  productionLineId String?
  productionLine   Category? @relation("MachineProductionLine", fields: [productionLineId], references: [id])

  statusId String
  status   Category @relation("MachineStatus", fields: [statusId], references: [id])

  maintenancePeriodId String?
  maintenancePeriod   Category? @relation("MachineMaintenancePeriod", fields: [maintenancePeriodId], references: [id])

  machineTypeId String?
  machineType   Category? @relation("MachineType", fields: [machineTypeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incidents       Incident[]
  maintenanceLogs MaintenanceLog[]

  @@map("machines")
}

model FailureCategory {
  id        String   @id @default(cuid())
  name      String
  isOther   Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  incidents Incident[]

  @@map("failure_categories")
}

model Incident {
  id                 String           @id @default(cuid())
  machine            Machine          @relation(fields: [machineId], references: [id])
  machineId          String
  reporter           User             @relation("Reporter", fields: [reporterId], references: [id])
  reporterId         String
  images             String?
  description        String
  status             IncidentStatus   @default(PENDING)
  category           FailureCategory? @relation(fields: [categoryId], references: [id])
  categoryId         String?
  customCategoryText String?

  assignedTo   User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedToId String?
  acceptedAt   DateTime?
  completedAt  DateTime?

  resendCount          Int       @default(0)
  lastResendAt         DateTime?
  lastCompletionPingAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenanceLogs MaintenanceLog[]
  chatMessages    ChatMessage[]

  @@map("incidents")
}

model MaintenanceLog {
  id                String        @id @default(cuid())
  incident          Incident      @relation(fields: [incidentId], references: [id])
  incidentId        String
  machine           Machine       @relation(fields: [machineId], references: [id])
  machineId         String
  technician        User          @relation(fields: [technicianId], references: [id])
  technicianId      String
  startTime         DateTime
  endTime           DateTime
  durationMinutes   Int
  repairDetail      String
  partsReplaced     String?
  proofImages       String?
  skillRating       Int?
  ratingSubmittedAt DateTime?
  createdAt         DateTime      @default(now())

  ratingRequest RatingRequest?

  @@map("maintenance_logs")
}

model RatingRequest {
  id               String         @id @default(cuid())
  maintenanceLog   MaintenanceLog @relation(fields: [maintenanceLogId], references: [id])
  maintenanceLogId String         @unique
  operator         User           @relation(fields: [operatorId], references: [id])
  operatorId       String
  status           RatingStatus   @default(PENDING)
  createdAt        DateTime       @default(now())
  respondedAt      DateTime?

  @@map("rating_requests")
}

model ChatGroup {
  id        String   @id @default(cuid())
  name      String
  image     String?
  createdAt DateTime @default(now())

  members     ChatGroupMember[]
  messages    ChatMessage[]
  invitations GroupInvitation[]

  @@map("chat_groups")
}

model ChatGroupMember {
  id       String    @id @default(cuid())
  group    ChatGroup @relation(fields: [groupId], references: [id])
  groupId  String
  user     User      @relation(fields: [userId], references: [id])
  userId   String
  joinedAt DateTime  @default(now())

  @@unique([groupId, userId])
  @@map("chat_group_members")
}

model ChatMessage {
  id         String          @id @default(cuid())
  group      ChatGroup       @relation(fields: [groupId], references: [id])
  groupId    String
  sender     User?           @relation(fields: [senderId], references: [id])
  senderId   String?
  type       ChatMessageType @default(TEXT)
  content    String
  incident   Incident?       @relation(fields: [incidentId], references: [id])
  incidentId String?
  createdAt  DateTime        @default(now())

  @@map("chat_messages")
}

model GroupInvitation {
  id            String           @id @default(cuid())
  group         ChatGroup        @relation(fields: [groupId], references: [id])
  groupId       String
  invitedUser   User             @relation("InvitedUser", fields: [invitedUserId], references: [id])
  invitedUserId String
  invitedBy     User             @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedById   String
  status        InvitationStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  respondedAt   DateTime?

  @@map("group_invitations")
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  image       String?
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())

  @@map("announcements")
}

enum IssueStatus {
  REPORTED
  INVESTIGATING
  ROOT_CAUSE_FOUND
  ASSIGNED
  IN_PROGRESS
  DONE
}

model QualityIssue {
  id          String      @id @default(cuid())
  reporter    User        @relation("Reporter", fields: [reporterId], references: [id])
  reporterId  String
  description String
  images      String?
  poCode      String
  status      IssueStatus @default(REPORTED)

  areaId String?
  area   Category? @relation("IssueArea", fields: [areaId], references: [id])

  teamId String?
  team   Category? @relation("IssueTeam", fields: [teamId], references: [id])

  productionLineId String?
  productionLine   Category? @relation("IssueProductionLine", fields: [productionLineId], references: [id])

  failureCategoryId String?
  failureCategory   IssueFailureCategory? @relation(fields: [failureCategoryId], references: [id])

  investigationDeadline DateTime?
  investigationLocked   Boolean   @default(false)
  rootCause             String?
  solution              String?
  rootCauseDecidedBy    User?     @relation("RootCauseDecidedBy", fields: [rootCauseDecidedById], references: [id])
  rootCauseDecidedById  String?
  rootCauseDecidedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions FiveMOneESubmission[]
  task        MaintenanceTask?

  @@map("quality_issues")
}

enum SubmitterRole {
  QA
  LINE_LEADER
  TECHNOLOGY
}

model FiveMOneESubmission {
  id            String        @id @default(cuid())
  issue         QualityIssue  @relation(fields: [issueId], references: [id])
  issueId       String
  submitter     User          @relation(fields: [submitterId], references: [id])
  submitterId   String
  submitterRole SubmitterRole
  poCode        String
  images        String?

  man         String
  machine     String
  material    String
  method      String
  measurement String
  environment String

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([issueId, submitterId])
  @@map("five_m_one_e_submissions")
}

enum TaskStatus {
  PENDING
  ACCEPTED
  DONE
}

enum VerifyStatus {
  PENDING
  CONFIRMED_DONE
  REJECTED
}

model MaintenanceTask {
  id           String       @id @default(cuid())
  issue        QualityIssue @relation(fields: [issueId], references: [id])
  issueId      String       @unique
  assignedBy   User         @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  assignedById String
  assignee     User         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assigneeId   String
  status       TaskStatus   @default(PENDING)
  acceptedAt   DateTime?
  completedAt  DateTime?

  repairDetail  String?
  partsReplaced String?
  imagesBefore  String?
  imagesAfter   String?

  verifyDeadline   DateTime?
  lastVerifyPingAt DateTime?
  verifiedStatus   VerifyStatus @default(PENDING)
  verifiedAt       DateTime?
  verifiedBy       User?        @relation("TaskVerifiedBy", fields: [verifiedById], references: [id])
  verifiedById     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("maintenance_tasks")
}

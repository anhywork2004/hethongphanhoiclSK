{
  "$schema": "landing-portal/node_modules/wrangler/config-schema.json",
  "name": "hethongphanhoiclsk",
  "main": "landing-portal/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hethongphanhoiclsk"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tbs-may-moc-db",
      "database_id": "7cd8d3f7-1bf2-412f-b83d-01182509dd91"
    }
  ]
}
